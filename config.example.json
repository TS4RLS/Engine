{
    // Folder containing your source images
    "images_folder": "C:/Users/YourName/Pictures/The Sims 4 Loading Screens",
    // Your Sims 4 Mods folder
    "mods_folder": "C:/Users/YourName/Documents/Electronic Arts/The Sims 4/Mods",
    // Combine 2 portrait images side-by-side into one loading screen
    "is_vertical": false,
    // Rename every image to a random name (and convert to JPEG) before picking
    "rename_files": false,
    // Never block on the "press any key to close" prompt
    "non_interactive": true,
    // Loading screen output width
    "target_width": 1920,
    // Loading screen output height
    "target_height": 1080,
    // Launch The Sims 4 via Steam (steam://) instead of a direct .exe
    "launch_via_steam": true,
    // Sims 4 game install folder (only used when not launching via Steam)
    "game_folder": ""
}
